{
  "name": "seventwo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build && node scripts/prepare-sites.mjs",
    "lint": "oxlint",
    "test:settlement": "node --experimental-strip-types scripts/settlement-check.ts",
    "test:planning": "node --experimental-strip-types scripts/planning-check.ts",
    "test:auth": "node --experimental-strip-types scripts/auth-membership-check.ts",
    "test:notifications": "node --experimental-strip-types scripts/notification-check.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
